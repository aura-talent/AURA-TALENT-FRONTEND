{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aura-talent",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "-p", "3101"],
      "port": 3101
    },
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "../AURA-TALENT-BACKEND", "uvicorn", "app.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
